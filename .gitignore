# datasets are fetched at run time (hf-mirror), never in git
data/

# checkpoints stay on node09, EXCEPT iter040.pt: the final model, needed
# locally by serve_gomoku.py and to re-export the play page's weights
results/gomoku_ckpt_*/**
!results/gomoku_ckpt_p15/iter040.pt

# Core ML export: the .mlpackage is 21 MB and regenerable from iter040.pt in
# about a minute, so only the acceptance record goes in git
results/coreml_export/**
!results/coreml_export/coreml_report.json

# SwiftPM build products
ios/**/.build/

